# =============================================================
# .env は「秘密情報」と「読み込む設定ファイルの選択」だけを持つ。
# リレー / 有効化フラグ / cron などの非機密設定は config.json (JSON) で管理する。
# =============================================================

# 読み込む設定ファイルを切り替える。
#   未指定        -> config.json
#   APP_ENV=LOCAL -> config.local.json
# APP_ENV="LOCAL"

# -------------------------------------------------------------
# 鍵 (nsec1... または 64文字 hex のどちらでも可)
#   鍵は「機能ごと」に持つ。既定鍵 / メインアカウントという概念はない。
#   config.json で有効にした機能は、対応する <機能>_NSEC が必須。
#   共通アカウントにしたい場合は、各 <機能>_NSEC に「同じ鍵」を入れる。
# -------------------------------------------------------------
# SALMON_NSEC=""
# MANAGEMENT_NSEC=""
# CALENDAR_NSEC=""
# IOT_NSEC=""
# MONITOR_NSEC=""
# FLOWMETER_NSEC=""      # FlowmeterCommandBot と FlowmeterJob 共通
# PASSPORT_NSEC=""

# -------------------------------------------------------------
# その他の秘密情報
# -------------------------------------------------------------
# CalendarBot 用 LLM (任意。あると高精度解析)
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENAI_API_KEY="sk-..."

# MonitorBot 用 Discord Webhook (monitor.enabled=true なら必須)
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# IoTBot / SwitchBot (実機操作するなら必須)
# SWITCH_BOT_TOKEN=""
# SWITCH_BOT_SECRET=""

# MetadataRefreshJob: 再 Publish する「対象アカウント」の秘密鍵リスト。
# これは Bot の投稿鍵ではなく、メタデータを維持したいアカウント自身の鍵 (カンマ区切り)。
# METADATA_KEYS="nsec1...,nsec1..."
