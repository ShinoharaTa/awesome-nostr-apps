# =============================================================
# .env は「秘密情報」と「読み込む設定ファイルの選択」だけを持つ。
# リレー / 有効化フラグ / cron などの非機密設定は src/config/config.ts で管理する。
#
# 機能の ON/OFF は config.ts の各機能 "enabled" で行う。
# .env 側には、有効化した機能が必要とする秘密情報だけを入れる。
#
# ┌─────────────────┬──────────────────────┬───────────────────────────┬─────────┐
# │ 公開Bot/機能      │ 投稿鍵(.env)          │ その他の秘密(.env)          │ Nostr投稿│
# ├─────────────────┼──────────────────────┼───────────────────────────┼─────────┤
# │ shinoemon        │ SHINOEMON_NSEC 必須   │ OPENROUTER/OPENAI_API_KEY  │ する     │
# │                 │                      │ SWITCH_BOT_TOKEN/SECRET    │          │
# │ flowmeterChan    │ FLOWMETER_CHAN_NSEC  │ -                          │ する     │
# │ management       │ MANAGEMENT_NSEC      │ -                          │ する     │
# │ monitor          │ 不要                 │ DISCORD_WEBHOOK_URL 必須    │ しない   │
# │ passport         │ PASSPORT_NSEC        │ -                          │ する     │
# │ metadataRefresh  │ -（下記参照）          │ METADATA_KEYS 必須          │ 再Publish│
# └─────────────────┴──────────────────────┴───────────────────────────┴─────────┘
# =============================================================

# 読み込む設定ファイルを切り替える。
#   未指定        -> config.ts（base のみ）
#   APP_ENV=LOCAL -> config.ts + config.local.ts（ディープマージ）
# APP_ENV="LOCAL"

# -------------------------------------------------------------
# 投稿鍵 (nsec1... または 64文字 hex のどちらでも可)
#   鍵は「公開Botごと」に持つ。内部 skill は公開Botの鍵で投稿する。
#   config.ts で enabled=true にした公開Botは、対応する <Bot>_NSEC が必須。
#   ※ monitor は投稿しない(Discord通知のみ)ため NSEC は不要。
# -------------------------------------------------------------
# SHINOEMON_NSEC=""     # しのえもん（呼びかけ応答 / 照明 / 予定など）
# FLOWMETER_CHAN_NSEC="" # 流速ちゃん（コマンド応答 + 定期流速投稿）
# MANAGEMENT_NSEC=""    # management（管理コマンド）
# PASSPORT_NSEC=""      # passport（定期投稿）

# -------------------------------------------------------------
# 機能ごとの「その他の秘密」
# -------------------------------------------------------------
# shinoemon.calendar skill: LLM（任意。あると高精度解析。どちらか一方でよい）
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENAI_API_KEY="sk-..."

# monitor: Discord Webhook（monitor.enabled=true なら必須。投稿鍵は不要）
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# shinoemon.lightControl skill: SwitchBot（まいへや / 光ある？ / 光あれ！に使う）
# 対象の温湿度計・ライト名と allowControl は src/config/config.ts の shinoemon.home で指定。
# SWITCH_BOT_TOKEN=""
# SWITCH_BOT_SECRET=""

# metadataRefresh: 再 Publish する「対象アカウント」の秘密鍵リスト（カンマ区切り）。
#   これは Bot の投稿鍵ではなく、メタデータ(kind:0)を維持したいアカウント自身の鍵。
# METADATA_KEYS="nsec1...,nsec1..."
