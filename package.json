{
  "name": "awesome-nostr-apps",
  "version": "0.1.0",
  "description": "Unified, loosely-coupled Nostr bot and scheduled-job system (EEW delivery excluded).",
  "type": "module",
  "main": "dist/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "keywords": [
    "nostr",
    "bot"
  ],
  "license": "MIT",
  "dependencies": {
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "nostr-tools": "^2.10.4",
    "winston": "^3.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
