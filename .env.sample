# =============================================================
# Core (必須)
# =============================================================
# Bot のメイン秘密鍵 (hex 64 文字)
HEX=""

# 開発用: 実投稿・実操作を抑止し、ログ出力のみ行う
TEST_MODE="false"

# 任意: リレー一覧の上書き (カンマ区切り)。未指定なら既定リレーを使用
# RELAYS="wss://relay-jp.shino3.net,wss://yabu.me,wss://r.kojira.io,wss://relay-jp.nostr.wirednet.jp"

# ログレベル (error|warn|info|debug)
LOG_LEVEL="info"

# =============================================================
# SalmonBot (常時有効・追加設定不要)
# =============================================================

# =============================================================
# CalendarBot (任意・LLM があると高精度)
# =============================================================
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENAI_API_KEY="sk-..."
# LLM_MODEL_NAME="anthropic/claude-3.5-sonnet"

# =============================================================
# MonitorBot (DISCORD_WEBHOOK_URL があれば有効)
# =============================================================
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
# MONITOR_KEYWORDS="緊急,重要,注意"
# MONITOR_NPUBS="npub1...,npub2..."
# MONITOR_MENTION_NPUBS="npub1..."

# =============================================================
# IoTBot / SwitchBot (SWITCH_BOT_TOKEN+SECRET があれば有効)
# =============================================================
# SWITCH_BOT_TOKEN=""
# SWITCH_BOT_SECRET=""
# 実デバイス操作を許可する場合のみ true (既定は読み取り・応答のみ)
# SWITCH_BOT_ALLOW_CONTROL="false"

# =============================================================
# FlowmeterJob / FlowmeterCommandBot (FLOWMETER_ENABLED=true で有効)
# =============================================================
# FLOWMETER_ENABLED="false"
# FLOWMETER_CRON="*/10 * * * *"

# =============================================================
# MetadataRefreshJob (METADATA_KEYS があれば有効)
# =============================================================
# 再 Publish したいアカウントの秘密鍵 (nsec or hex, カンマ区切り)
# METADATA_KEYS="nsec1...,nsec1..."
# METADATA_RELAYS="wss://relay-jp.shino3.net,wss://yabu.me"
# METADATA_CRON="0 12 * * *"

# =============================================================
# PassportJob (PASSPORT_HEX があれば有効)
# =============================================================
# PASSPORT_HEX=""
# PASSPORT_TARGET_NPUB="npub1..."
# PASSPORT_CRON="0 1 * * *"
